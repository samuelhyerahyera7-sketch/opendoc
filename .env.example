# Postgres connection string. Locally, point this at any Postgres you have
# running. In Vercel, add the "Postgres" (or Neon) storage integration to
# your project from the dashboard's Storage tab — it sets this for you
# automatically (usually as POSTGRES_URL; add DATABASE_URL as an alias
# pointing to the same value, or rename references in server/db.mjs).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opendoc_dev

# Optional locally. In Vercel, add the "Blob" storage integration from the
# Storage tab — it injects this automatically. Without it, uploaded patient
# files are written to local disk under server/data/uploads instead (fine
# for local dev, NOT durable in a serverless deployment).
# BLOB_READ_WRITE_TOKEN=

# Backend port for local dev only (ignored on Vercel).
PORT=5175

# Optional. Without it, emails (booking confirmations, new-booking alerts to
# doctors, email verification, password reset) are logged to the server
# console instead of sent — the app still works, it just won't actually
# email anyone. Get a free key at https://resend.com and verify a sending
# domain (or use their onboarding@resend.dev sender for testing).
# RESEND_API_KEY=
# EMAIL_FROM="OpenDoc <onboarding@resend.dev>"

# Base URL used to build links inside emails (verify-email, reset-password).
# In Vercel this should be your production domain.
APP_URL=http://localhost:5173

# Comma-separated list of extra trusted origins allowed to call the API with
# credentials, beyond APP_URL itself (which is always allowed). Usually you
# don't need this — the frontend and API are served from the same origin in
# both dev (Vite proxy) and production (Vercel rewrites).
# CORS_ORIGIN=

# Admin accounts are no longer a single shared token. Create the first admin
# account with:
#   npm run migrate            # apply database migrations first
#   npm run create-admin -- you@example.com "A very long unique password" super_admin
# Then log in at /admin with that email/password — it sets a secure,
# HttpOnly session cookie (see server/adminAuth.mjs). Roles: super_admin,
# verification_admin, support_admin.

# !! DO NOT set this to "true" in production !! It auto-seeds ~36 fake demo
# doctors (with a shared demo password) the first time the doctors table is
# empty. It's for local dev only. Leave it unset (or "false") in every real
# deployment so production always starts with an empty, real directory.
SEED_DEMO_DATA=false

# Optional. A Mapbox public token (starts with "pk.") enables real address
# geocoding in the location/practice-area search boxes, on top of the
# built-in SA city/town list. Get one free at https://account.mapbox.com —
# the free tier (50K map loads/month) covers geocoding lookups too. Without
# it, location search still works, just limited to the built-in city list.
# This is a VITE_ var, so it's bundled into the client — use the public
# token only, never a secret token.
# VITE_MAPBOX_TOKEN=
